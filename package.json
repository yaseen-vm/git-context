{
  "name": "@yaseen-vm/git-context",
  "version": "0.1.2",
  "description": "CLI tool that gathers and structures repository context for AI-powered code reviews",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "git-context": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test:run && npm run build",
    "build:bundle": "esbuild src/cli.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist-bundle/cli.cjs",
    "build:binary": "npm run build:bundle && pkg dist-bundle/cli.cjs --target node20-win-x64 --output binaries/git-context-win-x64.exe",
    "build:binaries": "npm run build:bundle && pkg dist-bundle/cli.cjs --target node20-linux-x64,node20-macos-x64,node20-macos-arm64,node20-win-x64 --out-path binaries --no-bytecode --public"
  },
  "keywords": [
    "git",
    "ai",
    "code-review",
    "cli",
    "context"
  ],
  "author": "yaseen-vm",
  "repository": {
    "type": "git",
    "url": "https://github.com/yaseen-vm/git-context"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitest/coverage-v8": "^4.1.7",
    "@yao-pkg/pkg": "^5.12.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "ignore": "^7.0.5",
    "parse-diff": "^0.12.0",
    "simple-git": "^3.36.0",
    "ts-morph": "^28.0.0"
  }
}
